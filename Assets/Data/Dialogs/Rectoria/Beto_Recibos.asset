  defaultPortrait: {fileID: 575421303, guid: 1ec23a5c4a3256142b46ca42b6597a1a, type: 3}
  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: "Tu inscripci\xF3n cuesta $1,850. Busca en la mesa los recibos que sumen
      exactamente esa cantidad."
  - speaker: 
    portrait: {fileID: 0}
    text: "Hay un recibo de cada cantidad: $300, $450, $600, $700, $850 y $1,000.
      Ac\xE9rcate a la mesa y presiona E o Enter para comenzar."
