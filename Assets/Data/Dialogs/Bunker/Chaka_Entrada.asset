  m_Script: {fileID: 11500000, guid: 0ab75097a03ca5949a4a575720fbd9bc, type: 3}
  m_Name: Chaka_Entrada
  m_EditorClassIdentifier: Assembly-CSharp::CampusQuest.Dialogue.DialogueDefinition
  dialogueId: bunker.chaka.entrada
  defaultSpeaker: El Chaka
  defaultPortrait: {fileID: 0}
  lines:
  - speaker: El Chaka
    portrait: {fileID: 0}
    text: Vaya vaya pero si aqui tenemos al rambo de la cantera
  - speaker: Mateo
    portrait: {fileID: 0}
    text: "Rambo cobraba por misi\xF3n; yo solo vengo por mi calificaci\xF3n y mi
      sello. \xBFEmpezamos o le da fr\xEDo?"
